new file mode 100644
index 0000000..020a70e
--- /dev/null
+++ b/packages/gui-extensions/src/upgrade/main.ts
@@ -0,0 +1,74 @@
+import { Schema } from "effect"
+import type { MainSetup } from "../sdk/main"
+import { Upgrade, type Policy } from "./contract"
+import type definition from "./index"
+import { compare } from "./version"
+
+// The publisher's policy file. SUPERVIBECODE_VERSION_URL points elsewhere, as for testing a build from source.
+const DEFAULT_URL = "https://supervibecode.ai.id/version.json"
+
+// A release goes out every few days at most; the window still asks again when the user says they updated.
+const REFRESH_MS = 6 * 60 * 60 * 1000
+
+const Manifest = Schema.Struct({
+  minimum: Schema.optional(Schema.String),
+  latest: Schema.optional(Schema.String),
+  message: Schema.optional(Schema.String),
+  download: Schema.optional(Schema.String),
+})
+
+/**
+ * Reads which versions are still supported from the publisher's version.json and tells every window. Without the file,
+ * offline, or with a file it can't read, the app stays usable: only a policy it read can require an update.
+ */
+const setup: MainSetup<typeof definition> = (ctx) => {
+  const url = process.env.SUPERVIBECODE_VERSION_URL || DEFAULT_URL
+  const enabled = Boolean(process.env.SUPERVIBECODE_VERSION_URL) || (ctx.build.packaged && ctx.build.channel !== "dev")
+  const site = new URL(url).origin
+  const base: Policy = {
+    status: "unknown",
+    current: ctx.build.version,
+    download: `${site}/#download`,
+    site,
+    os: process.platform === "darwin" ? "mac" : process.platform === "win32" ? "windows" : "linux",
+  }
+  const state = { value: base }
+  const publish = { changed: () => {} }
+
+  const refresh = async () => {
+    if (!enabled) return state.value
+    const manifest = await fetch(url, { cache: "no-store", signal: AbortSignal.timeout(15_000) })
+      .then((response) => (response.ok ? response.json() : undefined))
+      .then((json) => Schema.decodeUnknownOption(Manifest)(json))
+      .catch(() => undefined)
+
+    // A failed read keeps the last answer, so a requirement already known survives a network drop.
+    if (!manifest || manifest._tag === "None") return state.value
+    state.value = { ...base, ...decide(ctx.build.version, manifest.value) }
+    publish.changed()
+
+    return state.value
+  }
+
+  const provider = ctx.provide(Upgrade, { state: () => state.value, refresh })
+  publish.changed = () => provider.changed()
+
+  void refresh()
+  const timer = setInterval(() => void refresh(), REFRESH_MS)
+  ctx.scope.addFinalizer(() => clearInterval(timer))
+}
+
+function decide(current: string, manifest: typeof Manifest.Type) {
+  const extra = {
+    ...(manifest.latest ? { latest: manifest.latest } : {}),
+    ...(manifest.message ? { message: manifest.message } : {}),
+    ...(manifest.download ? { download: manifest.download } : {}),
+  }
+
+  if (manifest.minimum && compare(current, manifest.minimum) < 0) return { ...extra, status: "required" as const }
+  if (manifest.latest && compare(current, manifest.latest) < 0) return { ...extra, status: "outdated" as const }
+
+  return { ...extra, status: "current" as const }
+}
+
+export default setup
diff --git a/packages/gui-extensions/src/upgrade/renderer.tsx b/packages/gui-extensions/src/upgrade/renderer.tsx
new file mode 100644
index 0000000..7ad76b7
--- /dev/null
+++ b/packages/gui-extensions/src/upgrade/renderer.tsx
@@ -0,0 +1,91 @@
+import { showToast } from "@opencode/ui/toast"
+import { createSignal, lazy } from "solid-js"
+import { createKeyed, type Setup } from "../sdk"
+import type { Policy } from "./contract"
+import type definition from "./index"
+
+/**
+ * Keeps users on a supported version. Below the publisher's minimum, a dialog that can't be dismissed asks for the
+ * update; below the latest version, a reminder shows once per release.
+ */
+const setup: Setup<typeof definition> = (ctx) => {
+  if (!ctx.desktop) return
+  const Required = lazy(() => import("./required"))
+  // Bumped when the required dialog is dismissed anyway (Escape, a backdrop click), which opens it again.
+  const [opened, setOpened] = createSignal(0)
+
+  const policy = (): Policy | undefined => {
+    const live = ctx.uses.upgrade()
+
+    return live.status === "active" ? live.value.state() : undefined
+  }
+
+  /** Installs the update where the app can do it itself; a Mac without a signed build, or a failure, downloads it. */
+  const update = async () => {
+    const current = policy()
+    const updater = ctx.uses.updater()
+
+    if (!current) return
+    if (current.os !== "mac" && updater.status === "active") {
+      const state = await updater.value.check({ signal: ctx.signal }).catch(() => undefined)
+
+      if (state?.status === "ready" || state?.status === "download-required")
+        return void updater.value.install().catch(() => ctx.system.openExternal(current.download))
+    }
+    ctx.system.openExternal(current.download)
+  }
+
+  const recheck = async () => {
+    const live = ctx.uses.upgrade()
+
+    if (live.status !== "active") return
+
+    return live.value.refresh({ signal: ctx.signal }).catch(() => undefined)
+  }
+
+  createKeyed(
+    () => (policy()?.status === "required" ? opened() + 1 : undefined),
+    () => {
+      ctx.dialogs.open(
+        () => (
+          <Required
+            policy={() => policy()}
+            update={update}
+            recheck={recheck}
+            dismissed={() => setOpened((count) => count + 1)}
+          />
+        ),
+        { replace: true },
+      )
+    },
+  )
+
+  createKeyed(
+    () => {
+      const current = policy()
+
+      if (current?.status !== "outdated" || !current.latest) return
+      if (ctx.stores.dismissed.value.version === current.latest) return
+
+      return current.latest
+    },
+    (latest) => {
+      const current = policy()
+
+      showToast({
+        title: ctx.t("outdated.title", { latest }),
+        description: ctx.t("outdated.description", { current: current?.current ?? ctx.build.version }),
+        persistent: true,
+        actions: [
+          { label: ctx.t("outdated.update"), variant: "primary", onClick: () => void update() },
+          {
+            label: ctx.t("outdated.later"),
+            onClick: () => ctx.stores.dismissed.set({ version: latest }),
+          },
+        ],
+      })
+    },
+  )
+}
+
+export default setup
